# Customers Routes

# Get all customers
GET http://localhost:3000/customer
Content-Type: application/json

###

# Get a single customer by ID (replace :id with an actual customer ID)
GET http://localhost:3000/customer/6713b7194cc9dfefe807da17
Content-Type: application/json

###

# Add a new customer
POST http://localhost:3000/customer 
Content-Type: application/json

{
    "customer_name": "jane bill",
    "customer_phone": "123-000-7890",
    "customer_address": "456 Main St",
    "customer_notes": "New customer jane"
}

###

# Update an existing customer by ID (replace :id with an actual customer ID)
PUT http://localhost:3000/customer/6713b7194cc9dfefe807da17
Content-Type: application/json

{
    "customer_name": "Jane jones",
    "customer_phone": "1254-765-4321",
    "customer_address": "67 Elm St",
    "customer_notes": "fix last name and address"
}

###

# Delete a customer by ID (replace :id with an actual customer ID)
DELETE http://localhost:3000/customer/6713a26b64669bfe62de830c
Content-Type: application/json

